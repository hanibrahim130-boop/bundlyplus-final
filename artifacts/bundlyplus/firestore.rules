rules_version = '2';

// BundlyPlus Firestore security rules.
//
// Customer auth = Clerk; admin auth = Firebase Auth with `admin` custom claim.
// To bridge Clerk -> Firestore safely, deploy these rules together with one of:
//   (a) a Clerk -> Firebase custom-token exchange (sets request.auth.uid = clerkUserId), or
//   (b) move all customer writes through the API server with a Firebase Admin SDK.
//
// Until either bridge is deployed, customer writes will fail under these rules.
// During development you can temporarily fall back to permissive rules in the
// Firebase console, but production MUST run with the rules below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Public catalog data (managed by admin).
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile, wishlist, cart — owner-only writes; admin can read.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders — owner can create their own pending orders and read them.
    // Status transitions (confirm/deliver/cancel) and listAll are admin-only.
    // Owner updates are restricted to flipping `whatsappOpened` (+ `updatedAt`)
    // on their own pending order — no item, price, contact or status mutation.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if isAdmin() ||
        (
          request.auth != null
          && resource.data.userId == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["whatsappOpened", "updatedAt"])
        );
      allow delete: if isAdmin();
    }

    // Subscriptions — created server-side / admin-side only; owner can read.
    match /subscriptions/{subId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
