# ============================================================================
# BundlyPlus — Environment variables example
# Copy to `.env` and fill in for local dev. Do not commit `.env`.
# ============================================================================

# ---- Database (lib/db, scripts) -------------------------------------------
# PostgreSQL connection string used by Drizzle.
DATABASE_URL=postgres://user:password@localhost:5432/bundlyplus

# ---- API server (artifacts/api-server) ------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ---- BundlyPlus frontend (artifacts/bundlyplus) ---------------------------
# Vite-exposed vars must be prefixed with VITE_.
# Email of the Firebase Auth user with the `admin` custom claim.
VITE_ADMIN_EMAIL=admin@example.com

# Optional: override the dev server port / public base path.
# PORT=3000
# BASE_PATH=/

# ---- Firebase Admin (scripts/set-admin-claim, server-side) ----------------
# Path to a Firebase service-account JSON key file, OR inline JSON.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- Scripts (scripts/github-push.ts) -------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
